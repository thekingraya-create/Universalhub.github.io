local WALL_HEIGHT = 7.5
local WALL_THICKNESS = 0.5
local ROOF_THICKNESS = 0.5
local ACTION_NAME = "PalletContainmentHold"

local barriers = {}
local containmentEnabled = false

local function cleanup()
    for _, part in ipairs(barriers) do
        if part and part.Parent then
            part:Destroy()
        end
    end
    barriers = {}
    containmentEnabled = false
end

local function onCharacterAdded(char)
