})

local function teleportToPlayer(targetPlayer)
    if not targetPlayer then
        Rayfield:Notify({
            Title = "Error",
            Content = "No player selected!",
            Duration = 3,
        })
        return
    end
    
    local targetCharacter = targetPlayer.Character
    local localCharacter = LocalPlayer.Character
    
    if not targetCharacter or not localCharacter then
        Rayfield:Notify({
            Title = "Error",
            Content = "Character not loaded!",
            Duration = 3,
        })
        return
    end
    
    local targetHRP = targetCharacter:FindFirstChild("HumanoidRootPart")
    local localHRP = localCharacter:FindFirstChild("HumanoidRootPart")
    
    if not targetHRP or not localHRP then
        Rayfield:Notify({
            Title = "Error",
            Content = "HumanoidRootPart missing!",
            Duration = 3,
        })
        return
    end
    
    local offset = targetHRP.CFrame.LookVector * 5
    localHRP.CFrame = CFrame.new(targetHRP.Position + offset)
    
    Rayfield:Notify({
        Title = "Success",
        Content = "Teleported to " .. targetPlayer.Name,
        Duration = 3,
    })
end

