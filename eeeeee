-- PLAYER
local player = Players.LocalPlayer
local character = nil
local root = nil

----------------------------------------------------
-- CONFIG
----------------------------------------------------
local WALL_HEIGHT = 7.5
local WALL_THICKNESS = 0.5
local ROOF_THICKNESS = 0.5
local ACTION_NAME = "PalletContainmentHold"

----------------------------------------------------
local barriers = {}
local containmentEnabled = false

----------------------------------------------------
-- CHARACTER HANDLING
----------------------------------------------------
local function cleanup()
    for _, part in ipairs(barriers) do
        if part and part.Parent then
            part:Destroy()
        end
    end
    barriers = {}
    containmentEnabled = false
end

local function onCharacterAdded(char)
    cleanup()
    character = char
    root = char:WaitForChild("HumanoidRootPart", 5)
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
    onCharacterAdded(player.Character)
end

player.CharacterRemoving:Connect(cleanup)

----------------------------------------------------
-- PALLET DETECTION
----------------------------------------------------
local function getPallet()
    if not root or not character then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { character }
    params.IgnoreWater = true

    local result = workspace:Raycast(
        root.Position,
        Vector3.new(0, -12, 0),
        params
    )

    if result and result.Instance and result.Instance:IsA("BasePart") then
        return result.Instance
    end

    return nil
end

----------------------------------------------------
-- BARRIER CREATION
----------------------------------------------------
local function makeBarrier(size, cframe, pallet)
    local part = Instance.new("Part")
    part.Size = size
    part.CFrame = cframe
    
    -- Görünmezlik ve Fizik Ayarları
    part.Transparency = 1
    part.CanCollide = true      -- İçinden geçilmemesi için aktif
    part.CanTouch = false       -- Grab scriptlerini engellemek için kapalı
    part.CanQuery = false       -- Mouse ile seçilmeyi engellemek için kapalı
    
    -- Grab Engelleyici Diğer Ayarlar
    part.Massless = true
    part.Anchored = false       -- Weld kullanılacağı için false kalmalı
    part.CastShadow = false
    part.Name = "AntiGrabBarrier"
    
    -- ÖNEMLİ: Parçayı Pallet içine değil, Character içine koyuyoruz. 
    -- Bu sayede pallet'i tutan scriptler bariyeri görmez.
    part.Parent = character 

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = pallet
    weld.Part1 = part
    weld.Parent = part

    table.insert(barriers, part)
end

----------------------------------------------------
-- SPAWN BARRIERS
----------------------------------------------------
local function spawnBarriers(pallet)
    if containmentEnabled then return end

    local size = pallet.Size
    local cf = pallet.CFrame

    local baseY = size.Y / 2
    local wallY = baseY + WALL_HEIGHT / 2

    -- FRONT
    makeBarrier(
        Vector3.new(size.X, WALL_HEIGHT, WALL_THICKNESS),
        cf * CFrame.new(0, wallY, size.Z / 2 + WALL_THICKNESS / 2),
        pallet
    )

    -- BACK
    makeBarrier(
        Vector3.new(size.X, WALL_HEIGHT, WALL_THICKNESS),
        cf * CFrame.new(0, wallY, -size.Z / 2 - WALL_THICKNESS / 2),
        pallet
    )

    -- RIGHT
    makeBarrier(
        Vector3.new(WALL_THICKNESS, WALL_HEIGHT, size.Z),
        cf * CFrame.new(size.X / 2 + WALL_THICKNESS / 2, wallY, 0),
        pallet
    )

    -- LEFT
    makeBarrier(
        Vector3.new(WALL_THICKNESS, WALL_HEIGHT, size.Z),
        cf * CFrame.new(-size.X / 2 - WALL_THICKNESS / 2, wallY, 0),
        pallet
    )

    -- ROOF
    makeBarrier(
        Vector3.new(size.X, ROOF_THICKNESS, size.Z),
        cf * CFrame.new(0, baseY + WALL_HEIGHT + ROOF_THICKNESS / 2, 0),
        pallet
    )

    containmentEnabled = true
end

----------------------------------------------------
-- INPUT HANDLING (Q Tuşu)
----------------------------------------------------
local function handleAction(actionName, inputState)
    if inputState == Enum.UserInputState.Begin then
        if not containmentEnabled then
            local pallet = getPallet()
            if pallet then
                spawnBarriers(pallet)
            end
        end
    elseif inputState == Enum.UserInputState.End then
        cleanup()
    end
    return Enum.ContextActionResult.Sink
end

ContextActionService:BindAction(
    ACTION_NAME,
    handleAction,
    false,
    Enum.KeyCode.C)
   end,
