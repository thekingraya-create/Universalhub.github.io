--// ESP SETTINGS
local ESP_ENABLED = false
local TEAM_CHECK_ENABLED = true

local ESP_COLOR = Color3.fromRGB(255, 0, 0)


--// Remove a player's highlight
local function removeHighlight(player)
    local character = player.Character

    if not character then
        return
    end

    local highlight = character:FindFirstChild("JailbirdESP")

    if highlight then
        highlight:Destroy()
    end
end


--// Remove all highlights
local function clearESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            removeHighlight(player)
        end
    end
end


--// Update player's highlight
local function updateESP(player)
    if player == LocalPlayer then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        removeHighlight(player)
        return
    end

    --// Team check
    local isEnemy = true

    if TEAM_CHECK_ENABLED then
        local localTeam = LocalPlayer.Team
        local targetTeam = player.Team

        if localTeam and targetTeam then
            isEnemy = localTeam ~= targetTeam
        elseif not localTeam and not targetTeam then
            isEnemy = false
        end
    end

    local highlight = character:FindFirstChild("JailbirdESP")

    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "JailbirdESP"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = character
    end

    --// Colors
highlight.FillColor = ESP_COLOR
highlight.OutlineColor = ESP_COLOR
end


--// Update ESP when enabled
local function updateAllESP()
    if not ESP_ENABLED then
        clearESP()
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            updateESP(player)
        end
    end
end


--// ESP toggle
PVPTab:CreateToggle({
